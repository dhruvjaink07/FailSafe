# FailSafe environment template
# Copy this file to .env and replace placeholders.
# Never commit real secrets.

# ============================================================
# DATABASE CONFIGURATION (choose ONE mode)
# ============================================================

# MODE A (recommended for shared team data): use a full DB_URL
# - Local backend + Render shared DB: use Render EXTERNAL URL
# - Render backend + Render DB: use Render INTERNAL URL
# Example:
# DB_URL=postgresql://failsafe_dev:<password>@<host>:5432/failsafe?sslmode=require
DB_URL=

# MODE B (local/docker fallback): build DSN from parts
# Leave DB_URL empty when using this mode.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# Optional override. If empty, app auto-selects:
# - disable for localhost/127.0.0.1/::1/postgres
# - require for remote hosts
DB_SSLMODE=

# ============================================================
# REQUIRED APP CONFIGS
# ============================================================
# These are required by startup validation. If not used in your setup,
# keep them as "local" placeholders.

CONFIG_PARAM_1=local
CONFIG_PARAM_2=local
CONFIG_PARAM_3=local
CONFIG_PARAM_4=local
CONFIG_PARAM_5=local

# ============================================================
# OPTIONAL CONFIGS
# ============================================================

# APK uploads directory (relative or absolute)
# APK_UPLOAD_DIR=uploads/apks

# Android executor URL (when backend calls host executor service)
# Local host run usually: http://localhost:9090
# Docker backend on local machine usually: http://host.docker.internal:9090
# ANDROID_EXECUTOR_URL=http://localhost:9090

# Optional explicit aapt path
# AAPT_PATH=C:\Android\Sdk\build-tools\34.0.0\aapt.exe

# Optional Android SDK paths
# ANDROID_SDK_ROOT=C:\Android\Sdk
# ANDROID_HOME=C:\Android\Sdk

# Optional bootstrap token used by key provisioning workflows
# API_KEY_BOOTSTRAP_TOKEN=replace-with-strong-random-token
